doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Pug Cheatsheet
  body
    header
      h1 Pug Cheatsheet
      p Referência rápida de sintaxe

    section
      h2 Comentários
      pre
        code.
          //- Comentário de uma linha

    section
      h2 Tags
      .row
        pre
          code.
            div
            h1
            minha-tag
            .classe
            #id
            div.classe#id
        pre
          code.
            &lt;div&gt;&lt;/div&gt;
            &lt;h1&gt;&lt;/h1&gt;
            &lt;minha-tag&gt;&lt;/minha-tag&gt;
            &lt;div class="classe"&gt;&lt;/div&gt;
            &lt;div id="id"&gt;&lt;/div&gt;
            &lt;div class="classe" id="id"&gt;&lt;/div&gt;

    section
      h2 Atributos
      .row
        pre
          code.
            div(class="foo" id="bar")
            a(href="#" target="_blank") Link
            img(src="foto.png" alt="Foto")
            input(disabled)
        pre
          code.
            &lt;div class="foo" id="bar"&gt;&lt;/div&gt;
            &lt;a href="#" target="_blank"&gt;Link&lt;/a&gt;
            &lt;img src="foto.png" alt="Foto"&gt;
            &lt;input disabled&gt;

    section
      h2 JavaScript
      .row
        pre
          code.
            - const nome = "Bob"
            h1 Olá, #{nome}
            h2= nome
        pre
          code.
            &lt;h1&gt;Olá, Bob&lt;/h1&gt;
            &lt;h2&gt;Bob&lt;/h2&gt;

    section
      h2 Loops
      .row
        pre
          code.
            each v in [1, 2, 3]
              p= v
        pre
          code.
            &lt;p&gt;1&lt;/p&gt;
            &lt;p&gt;2&lt;/p&gt;
            &lt;p&gt;3&lt;/p&gt;

    section
      h2 Condicionais
      .row
        pre
          code.
            if n > 5
              p grande
            else
              p pequeno
        pre
          code.
            &lt;p&gt;pequeno&lt;/p&gt;

    section
      h2 Mixins
      .row
        pre
          code.
            mixin card(t)
              .card= t
            +card("Olá")
        pre
          code.
            &lt;div class="card"&gt;Olá&lt;/div&gt;

    footer
      p Documentação:
        a(href="https://pugjs.org" target="_blank" rel="noopener")  pugjs.org